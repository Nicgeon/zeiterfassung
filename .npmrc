# Keine Installationsskripte von Paketen ausführen.
# better-sqlite3 und argon2 bringen fertige Module für Windows, macOS und Linux mit; ohne diese Einstellung
# versucht npm 11 (ab Node 24) better-sqlite3 trotzdem zu kompilieren, was ohne Visual Studio scheitert.
# Nebeneffekt: Ein manipuliertes Paket kann beim Installieren keinen Code ausführen.
ignore-scripts=true
