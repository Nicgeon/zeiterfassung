# Kopieren nach ".env" und alle Werte ausfuellen. ".env" NIE einchecken
# (steht in .gitignore) und mit restriktiven Dateirechten schuetzen
# (z.B. chmod 600 .env), da hier Geheimnisse drinstehen.

NODE_ENV=production
PORT=3000

# Verzeichnis in der Container-Datei fuer die SQLite-Datenbank. Bei
# docker-compose entspricht das dem gemounteten Volume, muss also nicht
# angepasst werden.
DATA_DIR=/app/data

# --- Geheimnisse -------------------------------------------------------
# Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 32 Byte (64 Hex-Zeichen) fuer AES-256 - verschluesselt die Aufgaben-Texte
# in der Datenbank. Bei Verlust dieses Schluessels sind bestehende Eintraege
# NICHT mehr entschluesselbar - sicher aufbewahren (z.B. Passwort-Tresor
# des Unternehmens), niemals in Git einchecken.
ENCRYPTION_KEY=

# Erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Signiert die Session-Cookies.
SESSION_SECRET=

# --- WebAuthn / Passkeys -------------------------------------------------
# RP_ID: die Domain, unter der die App erreichbar ist (ohne https://, ohne
# Port, ohne Pfad). Muss exakt zur echten, oeffentlichen Domain passen -
# nicht "localhost", sobald die App hinter nginx proxy manager laeuft.
RP_ID=zeit.ihre-firma.example

# RP_NAME: Anzeigename, den Browser/Betriebssystem beim Passkey-Dialog zeigen.
RP_NAME=Zeiterfassung

# RP_ORIGIN: die volle Origin-URL inkl. https://, ohne Pfad, ohne
# abschliessenden Slash. Muss exakt der URL entsprechen, unter der die
# Anwender die Seite aufrufen.
RP_ORIGIN=https://zeit.ihre-firma.example

# Optional: weitere Adressen, unter denen dieselbe Installation erreichbar
# ist, kommagetrennt und jeweils als vollstaendige URL. Beispiel:
#   RP_ORIGINS=https://tt.kurz.example,https://zeit.alt.example
# Hinweis: Passkeys sind laut Standard immer an genau eine Domain gebunden.
# Wer beide Adressen nutzt, legt pro Adresse einen eigenen Passkey an.
# Anmeldung per Passwort und 2FA funktioniert unabhaengig davon ueberall.
RP_ORIGINS=

# --- Cookies / Netzwerk --------------------------------------------------
# true, sobald HTTPS aktiv ist (Normalfall hinter nginx proxy manager mit
# Let's Encrypt). Nur fuer lokale Tests ohne HTTPS auf "false" setzen.
COOKIE_SECURE=true

# true, wenn ein Reverse-Proxy (nginx proxy manager) vorgeschaltet ist -
# noetig, damit sichere Cookies und Client-IPs im Audit-Log korrekt
# funktionieren.
TRUST_PROXY=true

# true = nur die oben konfigurierten Adressen (RP_ORIGIN und RP_ORIGINS)
# werden bedient; andere Hostnamen, die auf diesen Server zeigen, erhalten
# eine Absage. Zugriffe ueber 127.0.0.1 bleiben erlaubt (Docker-Healthcheck).
# Vor dem Aktivieren pruefen, dass wirklich alle genutzten Adressen
# eingetragen sind.
STRICT_HOST=false

# --- Sitzungen / Login-Schutz ---------------------------------------------
SESSION_MAX_AGE_MINUTES=600

# Aufbewahrungsfrist fuer das Sicherheits-Protokoll in Tagen. Aeltere
# Eintraege werden taeglich automatisch geloescht (Datensparsamkeit).
# 0 = nie loeschen.
AUDIT_RETENTION_DAYS=90
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# --- Logs ------------------------------------------------------------------
# Zeitzone fuer die Zeitstempel in "docker compose logs" und der CLI.
LOG_TIMEZONE=Europe/Berlin

# --- Lokaler Betrieb (siehe README, "Lokaler Betrieb") ---
# LOCAL_MODE=true   -> nur localhost, automatische Anmeldung, Schluessel werden selbst erzeugt;
#                      ENCRYPTION_KEY/SESSION_SECRET/RP_* sind dann nicht noetig.
# PORT=4711         -> Port im lokalen Modus (Standard 4711)
# DATA_DIR=         -> Datenordner (Standard: %APPDATA%\Zeiterfassung bzw. ~/.zeiterfassung)
